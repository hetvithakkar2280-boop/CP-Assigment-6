#include <stdio.h>

/* Addition, subtraction and multiplication of two n x n matrices
   using pointers. a[i][j] is accessed as *(*(a + i) + j). */
int main() {
    int a[10][10], b[10][10], sum[10][10], diff[10][10], prod[10][10];
    int n, i, j, k;

    printf("Enter order of the square matrices (max 10): ");
    scanf("%d", &n);

    printf("Enter elements of first matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", (*(a + i) + j));

    printf("Enter elements of second matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", (*(b + i) + j));

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            *(*(sum + i) + j) = *(*(a + i) + j) + *(*(b + i) + j);
            *(*(diff + i) + j) = *(*(a + i) + j) - *(*(b + i) + j);
            *(*(prod + i) + j) = 0;
            for (k = 0; k < n; k++)
                *(*(prod + i) + j) += *(*(a + i) + k) * *(*(b + k) + j);
        }
    }

    printf("\nAddition:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++)
            printf("%d\t", *(*(sum + i) + j));
        printf("\n");
    }
    printf("\nSubtraction:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++)
            printf("%d\t", *(*(diff + i) + j));
        printf("\n");
    }
    printf("\nMultiplication:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++)
            printf("%d\t", *(*(prod + i) + j));
        printf("\n");
    }
    return 0;
}
